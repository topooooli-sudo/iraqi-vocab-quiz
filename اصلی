<!doctype html>
<html lang="fa" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<title>آزمون تعاملی عربی عراقی کادر درمان</title>
<style>
*{box-sizing:border-box}body{margin:0;background:linear-gradient(135deg,#eef5ff,#f8f2ff);font-family:Tahoma,Arial,sans-serif;color:#172033}.wrap{max-width:720px;margin:auto;padding:16px}.card{background:#fff;border-radius:22px;padding:22px;box-shadow:0 10px 35px #0001}.hide{display:none}.center{text-align:center}h1,h2{margin-top:0}.meta{font-size:13px;color:#68738a}.bar{height:8px;background:#e5e9f2;border-radius:20px;overflow:hidden;margin:10px 0 18px}.bar i{display:block;height:100%;background:#4b76ff;width:0;transition:.3s}.q{font-size:20px;font-weight:700;line-height:2;margin:15px 0}.opt{display:block;width:100%;text-align:right;background:#fff;border:2px solid #e1e6ef;border-radius:14px;padding:13px;margin:9px 0;font-size:16px;cursor:pointer}.opt:disabled{cursor:default}.ok{background:#eafff0!important;border-color:#1fa35a!important}.bad{background:#fff0f0!important;border-color:#dc4242!important}textarea{width:100%;min-height:145px;border:2px solid #dfe4ed;border-radius:14px;padding:12px;font:inherit;line-height:1.9}textarea:focus{outline:0;border-color:#4b76ff}.send{border:0;background:#4b76ff;color:#fff;padding:13px 22px;border-radius:13px;font-size:16px;font-weight:700;cursor:pointer}.score{font-size:44px;font-weight:900}.box{background:#f7f9fd;border-radius:16px;padding:14px;margin:10px 0;line-height:1.9}.wrong{border-right:5px solid #d94141;background:#fff5f5}.ai{border:1px solid #e1e6ef}.quote{font-size:20px;font-weight:bold;line-height:2.1;margin-top:20px}.celebration{padding:10px 0 18px}.flash{position:fixed;inset:0;z-index:9998;pointer-events:none;overflow:hidden}
.flash-core{position:absolute;left:50%;top:50%;width:34px;height:34px;border-radius:50%;transform:translate(-50%,-50%) scale(.2);background:#fff;box-shadow:0 0 8px #fff,0 0 22px #ffe45c,0 0 45px #ffd000,0 0 85px #fff2a6;animation:coreBurst .8s cubic-bezier(.15,.75,.25,1) forwards}
.flash-ring{position:absolute;left:50%;top:50%;width:50px;height:50px;border:5px solid #ffe36b;border-radius:50%;transform:translate(-50%,-50%) scale(.15);box-shadow:0 0 22px #fff,0 0 45px #ffd52e;animation:ringBurst .85s ease-out forwards}
.spark{position:absolute;left:50%;top:50%;width:7px;height:72px;border-radius:10px;background:linear-gradient(to top,#fff, #ffd83d, transparent);transform-origin:50% 100%;box-shadow:0 0 10px #fff,0 0 22px #ffd83d;animation:sparkBurst .7s ease-out forwards}
.flash-word{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%) scale(.5);font-size:25px;font-weight:900;color:#fff;text-shadow:0 0 8px #fff,0 0 18px #ffd83d,0 0 35px #ffb300;opacity:0;animation:wordPop .75s .08s ease-out forwards;white-space:nowrap}
@keyframes coreBurst{0%{opacity:0;transform:translate(-50%,-50%) scale(.1)}25%{opacity:1;transform:translate(-50%,-50%) scale(1.7)}100%{opacity:0;transform:translate(-50%,-50%) scale(5)}}
@keyframes ringBurst{0%{opacity:1;transform:translate(-50%,-50%) scale(.15)}100%{opacity:0;transform:translate(-50%,-50%) scale(8);border-width:1px}}
@keyframes sparkBurst{0%{opacity:0;transform:translate(-50%,-50%) rotate(var(--a)) translateY(0) scaleY(.2)}20%{opacity:1}100%{opacity:0;transform:translate(-50%,-50%) rotate(var(--a)) translateY(-170px) scaleY(1)}}
@keyframes wordPop{0%{opacity:0;transform:translate(-50%,-50%) scale(.5)}30%{opacity:1;transform:translate(-50%,-50%) scale(1.15)}100%{opacity:0;transform:translate(-50%,-50%) scale(1.3)}}45%{transform:rotate(90deg) scale(1.35)}100%{transform:rotate(180deg) scale(.8)}}
.heart{position:fixed;top:-45px;z-index:9999;font-size:28px;animation:fall 4s linear forwards;pointer-events:none}@keyframes fall{to{transform:translateY(110vh) rotate(360deg);opacity:.1}}
</style>
</head>
<body>
<div class="wrap">
<section id="start" class="card center"><h1>آزمون عربی عراقی کادر درمان</h1><p>۳۰ سؤال · ۲۰ نمره</p><p class="meta">واژگان اندام و معاینه، زمان افعال، ترجمه و ساعت</p><button class="send" onclick="startQuiz()">شروع آزمون</button></section>
<section id="quiz" class="card hide"><div id="meta" class="meta"></div><div class="bar"><i id="bar"></i></div><div id="body"></div></section>
<section id="result" class="card hide"></section>
</div>
<script src="https://developer.eitaa.com/eitaa-web-app.js"></script>
<script>
/* آدرس Web App تصحیح AI را در این متغیر قرار دهید. کلید API را هرگز در HTML نگذارید. */
const AI_ENDPOINT="";

const Q=[
{t:"m",p:.5,q:"«إِصْبَع» یعنی چه؟",a:["مچ دست","انگشت","آرنج","شانه"],c:1,w:"إِصْبَع",m:"انگشت"},
{t:"m",p:.5,q:"«مَرْفَق» یعنی چه؟",a:["آرنج","زانو","پاشنه","شکم"],c:0,w:"مَرْفَق",m:"آرنج"},
{t:"m",p:.5,q:"«رُكْبَة» یعنی چه؟",a:["مچ دست","گردن","زانو","کمر"],c:2,w:"رُكْبَة",m:"زانو"},
{t:"m",p:.5,q:"«مَعْصَم» یعنی چه؟",a:["مچ دست","انگشت پا","آرنج","پشت"],c:0,w:"مَعْصَم",m:"مچ دست"},
{t:"m",p:.5,q:"«كَعْب» یعنی چه؟",a:["شانه","پاشنه","شکم","گلو"],c:1,w:"كَعْب",m:"پاشنه"},
{t:"m",p:.5,q:"«كَتِف» یعنی چه؟",a:["شانه","زانو","چشم","مچ"],c:0,w:"كَتِف",m:"شانه"},
{t:"m",p:.5,q:"«بَطْن» یعنی چه؟",a:["پشت","شکم","سر","گوش"],c:1,w:"بَطْن",m:"شکم"},
{t:"m",p:.5,q:"«ظَهْر» یعنی چه؟",a:["پشت/کمر","دهان","پا","آرنج"],c:0,w:"ظَهْر",m:"پشت/کمر"},
{t:"m",p:.5,q:"«حَلْق» یعنی چه؟",a:["گلو","گوش","بینی","شانه"],c:0,w:"حَلْق",m:"گلو"},
{t:"m",p:.5,q:"«خَدَر» یعنی چه؟",a:["تورم","بی‌حسی","تب","سرفه"],c:1,w:"خَدَر",m:"بی‌حسی"},
{t:"m",p:.5,q:"«وَرَم» یعنی چه؟",a:["زخم","درد","تورم","سرگیجه"],c:2,w:"وَرَم",m:"تورم"},
{t:"m",p:.5,q:"«يِوَجِّع» یعنی چه؟",a:["می‌خوابد","درد می‌کند","راه می‌رود","می‌خورد"],c:1,w:"يِوَجِّع",m:"درد می‌کند"},
{t:"m",p:.5,q:"«يِحَرِّك» یعنی چه؟",a:["حرکت می‌دهد","می‌بیند","می‌شنود","می‌بندد"],c:0,w:"يِحَرِّك",m:"حرکت می‌دهد"},
{t:"m",p:.5,q:"«يِرَفِّع» یعنی چه؟",a:["پایین می‌آورد","بالا می‌برد","می‌چرخاند","می‌شوید"],c:1,w:"يِرَفِّع",m:"بالا می‌برد"},
{t:"m",p:.5,q:"«يِفْحَص» یعنی چه؟",a:["معاینه می‌کند","تزریق می‌کند","می‌خندد","می‌نویسد"],c:0,w:"يِفْحَص",m:"معاینه می‌کند"},
{t:"m",p:.5,q:"«وَيْن يِوَجِّعَك؟» یعنی چه؟",a:["چند سالته؟","کجا درد می‌کنه؟","کی میای؟","چی خوردی؟"],c:1,w:"وَيْن يِوَجِّعَك؟",m:"کجا درد می‌کند؟"},
{t:"m",p:.5,q:"«رَفِّع إِيدَك» یعنی چه؟",a:["دستت را پایین بیاور","دستت را بالا ببر","دستت را بشوی","دستت را ببند"],c:1,w:"رَفِّع إِيدَك",m:"دستت را بالا ببر"},
{t:"m",p:.5,q:"«اِفْتَح فَمَك» یعنی چه؟",a:["چشمت را ببند","دهانت را باز کن","سرت را بچرخان","پاهایت را بالا ببر"],c:1,w:"اِفْتَح فَمَك",m:"دهانت را باز کن"},
{t:"m",p:.5,q:"«خَلِّينِي أَشُوف» یعنی چه؟",a:["بگذار ببینم","بگذار بنویسم","بگذار بروم","بگذار بخوابم"],c:0,w:"خَلِّينِي أَشُوف",m:"بگذار ببینم"},
{t:"m",p:.5,q:"«يِمْشِي» یعنی چه؟",a:["می‌افتد","راه می‌رود","می‌نشیند","درد دارد"],c:1,w:"يِمْشِي",m:"راه می‌رود"},
{t:"m",p:.5,q:"«دَا يِمْشِي» چه زمانی را نشان می‌دهد؟",a:["ماضی","مضارع استمراری","آینده","ماضی بعید"],c:1},
{t:"m",p:.5,q:"کدام گزینه آینده را در عراقی درست می‌سازد؟",a:["راح يِفْحَص","چان يِفْحَص","دا فَحَص","فَحَص راح"],c:0},
{t:"m",p:.5,q:"کدام گزینه ساختار استمراری را درست نشان می‌دهد؟",a:["راح يِوَجِّع","دا يِوَجِّع","فَحَص يِوَجِّع","چان راح"],c:1},
{t:"m",p:.5,q:"کدام گزینه نمونه ماضی استمراری است؟",a:["چان يِفْحَص","دا يِفْحَص","راح يِفْحَص","يِفْحَص"],c:0},
{t:"m",p:.5,q:"«خَلِّينِي أَفْحَص إِيدَك» یعنی چه؟",a:["بگذار دستت را معاینه کنم","دستت را بالا ببر","دستت را بشوی","بگذار دستم را معاینه کنی"],c:0,w:"خَلِّينِي أَفْحَص إِيدَك",m:"بگذار دستت را معاینه کنم"},
{t:"e",p:2,q:"به عراقی بگو: «دکتر، از دیشب دستم خیلی درد می‌کنه.»",e:"دكتور، مِن البارحة إيدي تِوَجِّعْنِي هواي.",r:"معنا ۱؛ طبیعی بودن عراقی ۰٫۵؛ دستور ۰٫۵"},
{t:"e",p:2,q:"به عراقی بگو: «دهانت را باز کن تا گلویت را معاینه کنم.»",e:"اِفْتَح فَمَك خَلّيني أَفْحَص حَلْگَك.",r:"معنا ۱؛ طبیعی بودن عراقی ۰٫۵؛ دستور ۰٫۵"},
{t:"e",p:2,q:"به عراقی بگو: «اگر درد داشتی، فردا دوباره بیا درمانگاه.»",e:"إِذا عِنْدَك وَجَع، باچِر تَعال لِلْعِيادَة مَرّة ثانِيَة.",r:"معنا ۱؛ طبیعی بودن عراقی ۰٫۵؛ دستور ۰٫۵"},
{t:"e",p:1,q:"جمله «المريض يِمْشِي» را به زمان آینده تبدیل کن.",e:"المريض راح يِمْشِي.",r:"ساخت صحیح آینده ۱"},
{t:"e",p:.5,q:"«ساعت هشت و نیم صبح» را به عربی عراقی بگو.",e:"السّاعة ثمانِيَة ونِصّ الصبح.",r:"بیان طبیعی ساعت ۰٫۵"}
];

let idx=0,mcqScore=0,wrong=[],essays=[],uid="";
const L=["الف","ب","ج","د"];
function startQuiz(){document.getElementById('start').classList.add('hide');document.getElementById('quiz').classList.remove('hide');try{if(window.Eitaa&&Eitaa.WebApp){Eitaa.WebApp.ready();uid=String(Eitaa.WebApp.initDataUnsafe?.user?.id||'')}}catch(e){}show()}
function show(){let q=Q[idx];document.getElementById('meta').textContent=`سؤال ${idx+1} از ${Q.length} · ${q.p} نمره`;document.getElementById('bar').style.width=(idx/Q.length*100)+'%';let c=document.getElementById('body');if(q.t==='m'){c.innerHTML=`<div class="q">${q.q}</div><div id="opts"></div>`;q.a.forEach((x,n)=>{let b=document.createElement('button');b.className='opt';b.innerHTML=`<b>${L[n]}.</b> ${x}`;b.onclick=()=>choose(n,b);document.getElementById('opts').appendChild(b)})}else c.innerHTML=`<div class="q">${q.q}</div><textarea id="answer" placeholder="پاسخ خود را بنویسید..."></textarea><br><br><button class="send" onclick="saveEssay()">ثبت پاسخ</button>`}
function choose(n,b){let q=Q[idx],os=[...document.querySelectorAll('.opt')];os.forEach(x=>x.disabled=true);if(n===q.c){mcqScore+=q.p;b.classList.add('ok');vibrate();lightBurst()}else{b.classList.add('bad');os[q.c].classList.add('ok');wrong.push({w:q.w||q.q,m:q.m||q.a[q.c],chosen:q.a[n],correct:q.a[q.c]})}setTimeout(next,650)}
function saveEssay(){let v=document.getElementById('answer').value.trim();if(!v)return alert('لطفاً پاسخ خود را بنویسید.');essays.push({index:idx,answer:v,question:Q[idx].q,expected:Q[idx].e,rubric:Q[idx].r,maxScore:Q[idx].p});next()}
function next(){idx++;idx<Q.length?show():finish()}
async function finish(){document.getElementById('quiz').classList.add('hide');document.getElementById('result').classList.remove('hide');document.getElementById('result').innerHTML='<div class="center"><h2>آزمون تمام شد</h2><p>در حال آماده‌سازی تصحیح تشریحی...</p></div>';let graded=[];if(AI_ENDPOINT){try{let r=await fetch(AI_ENDPOINT,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({action:'grade_essays',userId:uid,answers:essays})});let d=await r.json();graded=d.results||[]}catch(e){}}if(!graded.length)graded=essays.map(x=>({score:0,maxScore:x.maxScore,answer:x.answer,expected:x.expected,feedback:'AI هنوز متصل نشده است؛ AI_ENDPOINT را به Web App سمت سرور متصل کنید.'}));let total=mcqScore+graded.reduce((s,x)=>s+(Number(x.score)||0),0);render(total,graded)}
function render(total,graded){let h=`<div class="center"><h2>نتیجه نهایی</h2><div class="score">${total.toFixed(1)} / 20</div></div>`;if(wrong.length){h+='<h3>معنی کلماتِ پاسخ‌داده‌شده به‌اشتباه</h3>';wrong.forEach(x=>h+=`<div class="box wrong"><b>${esc(x.w)}</b><br>${esc(x.m)}</div>`)}graded.forEach((x,n)=>{h+=`<div class="box ai"><b>سؤال ${n+1}</b><br>پاسخ هنرجو: ${esc(x.answer||'')}<br><div class="meta">تحلیل: ${esc(x.feedback||'')}</div><div class="meta"><b>پاسخ صحیح: ${esc(x.expected||'')}</b></div><b>نمره: ${x.score||0}/${x.maxScore}</b></div>`});if(!wrong.length)h+='<div class="box center">همه تست‌های معنی کلمات درست بود 🎉</div>';if(total>=18){h+=`<div class="center celebration"><div class="quote">الحَيَاةُ كَالثَّلْجِ، إِسْتَمْتِعْ بِهَا قَبْلَ أَنْ تَذُوْب</div><p>زندگی مثل یخ است، قبل از اینکه آب شود از آن لذت ببرید</p></div>`;setTimeout(hearts,150)}document.getElementById('result').innerHTML=h}

function lightBurst(){
let f=document.createElement('div');
f.className='flash';
f.setAttribute('aria-hidden','true');
f.innerHTML='<div class="flash-core"></div><div class="flash-ring"></div><div class="flash-word">آفرین! ✓</div>';
for(let i=0;i<20;i++){
let s=document.createElement('div');
s.className='spark';
s.style.setProperty('--a',(i*18)+'deg');
s.style.animationDelay=(i%4)*0.025+'s';
f.appendChild(s);
}
document.body.appendChild(f);
if(navigator.vibrate)navigator.vibrate([45,25,70,25,110]);
setTimeout(()=>f.remove(),1100)
}
function vibrate(){if(navigator.vibrate)navigator.vibrate([50,30,80])}function hearts(){for(let i=0;i<65;i++){let e=document.createElement('div');e.className='heart';e.textContent=['❤️','💖','💗','💕'][Math.floor(Math.random()*4)];e.style.left=Math.random()*100+'vw';e.style.animationDelay=Math.random()*1.2+'s';document.body.appendChild(e);setTimeout(()=>e.remove(),5500)}}function esc(s){return String(s).replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[m]))}
</script>
</body></ht
